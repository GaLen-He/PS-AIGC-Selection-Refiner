{
  "manifestVersion": 5,
  "id": "com.company.ps-aigc-selection-refiner",
  "name": "AIGC Selection Refiner",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "https://your-aigc-platform.example.com",
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aigcSelectionRefinerPanel",
      "label": {
        "default": "AIGC 选区细化"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "maximumSize": {
        "width": 720,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 680
      }
    }
  ]
}
